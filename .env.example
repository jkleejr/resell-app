# Copy to .env and fill in. Never commit .env.

# Required. Vision identification. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Vision model for /api/analyze. Defaults to claude-sonnet-4-6.
# Set MODEL=claude-haiku-4-5 to A/B test the ~3x-cheaper model on real photos
# (watch the "[analyze] model=… cost=$…" log line to compare).
# MODEL=claude-sonnet-4-6

# Cost guard + global scan counter (set these in Vercel for production).
# Create a free Redis DB at https://console.upstash.com and paste its REST creds.
# Without both, the scan cap is OFF and the global counter stays empty (fine for
# local dev). The Anthropic monthly spend limit is the hard backstop regardless.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Per-device daily scan cap (default 100).
# DAILY_DEVICE_CAP=150
# Per-device daily allowance for the paid price check (default 25). Each device
# spends its own allowance — this is not a shared pool, so it does not bound
# total daily search spend; GLOBAL_DAILY_CAP is what does.
# SEARCH_DEVICE_CAP=30
# Optional global daily cap across ALL users — a circuit breaker on total daily
# spend. Off unless set. Recommended for public launch (e.g. 1000).
# GLOBAL_DAILY_CAP=1000
