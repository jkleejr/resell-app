# The backend deploy only needs api/, lib/, public/, and config files.
# Exclude the mobile app and dependency/build folders (Vercel installs deps
# itself from package.json), which also keeps us under the upload file limit.
node_modules
mobile
.expo
.git
*.log
test
# Local secrets. .vercelignore replaces .gitignore for uploads, so the .env
# rule there doesn't apply here — without this, `vercel` would upload it.
.env
.env.*
!.env.example
